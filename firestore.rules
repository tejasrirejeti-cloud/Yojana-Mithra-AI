rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User Profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Subcollection: Saved Schemes
      match /savedSchemes/{schemeDocId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: Applications
      match /applications/{appId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: Chat Messages
      match /messages/{msgId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: OCR Scans
      match /ocrScans/{scanId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: Notifications
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Government Schemes Directory (Public Read, Admin/System Write)
    match /schemes/{schemeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Citizen Feedback
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
    }
  }
}
